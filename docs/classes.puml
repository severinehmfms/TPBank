@startuml

class AccountFactory{
    + createAccount(type : String) : Account
}

package "Model" #DDDDDD {
    class Customer {
        - id : int
        - name : String
        - firstName : String
        - lastName : String
        - mail : String
        + toString() : void
    }
    abstract class Account{
        - numAccount : String
        - typeAccount : String
        - dateCreate : Date
        - balance : double

        - customer : Customer
        - listTransactions : List(Transactions)
    }
    class CheckingAccount extends Account{
        + toString() : void
    }
    class SavingAccount extends Account{
        + toString() : void
        + getInterets() : double
    }
    abstract class Transaction{
        - id : int
        - dateTransaction : Date
        - amount : double

        - acccount : Account
    }
    class Deposit extends Transaction{

    }
    class Withdrawal extends Transaction{

    }
}

package "Services" #E3DFF2 {
    class CustomerServices{

    }
    class AccountServices{

    }
    class TransactionServices{

    }
}

package "Application" {

}

package "DAO" #FCF4F2 {
    interface CustomerDao {
        + findById(id : int) : Customer
        + findAll() : List<Customer>
        + save(customer : Customer) : void
    }
    class CustomerDaoImpl {
        + findById(id : int) : Customer
        + findAll() : List<Customer>
        + save(customer : Customer) : void
    }
    interface AccountDao {
        + findById(id : int) : Account
        + findAll() : List<Account>
        + save(account : Account) : void
    }
    class AccountDaoImpl {
        + findById(id : int) : Account
        + findAll() : List<Account>
        + save(account : Account) : void
    }
    interface TransactionDao {
        + findById(id : int) : Transaction
        + findAll() : List<Transaction>
        + save(transaction : Transaction) : void
    }
    class TransactionDaoImpl {
        + findById(id : int) : Transaction
        + findAll() : List<Transaction>
        + save(transaction : Transaction) : void
    }
}

class DatabaseConnection <<Singleton>> {
    {static} instance : DatabaseConnection
    - url : String
    - user : String
    - password : String
    + getInstance() : DatabaseConnection
}

Account "1.*" -- "1" Customer
Account "1" -- "0.*" Transaction

AccountFactory ..> Account : crée

CustomerDaoImpl ..> DatabaseConnection : utilise
AccountDaoImpl ..> DatabaseConnection : utilise
TransactionDaoImpl ..> DatabaseConnection : utilise

CustomerDaoImpl ..|> CustomerDao
CustomerDaoImpl ..> Customer : retourne / utilise

AccountDaoImpl ..|> AccountDao
AccountDaoImpl ..> Account : retourne / utilise
AccountDaoImpl ..> AccountFactory : utilise

TransactionDaoImpl ..|> TransactionDao
TransactionDaoImpl ..> Transaction : retourne / utilise

CustomerServices ..> CustomerDaoImpl : utilise
AccountServices ..> AccountDaoImpl : utilise
TransactionServices ..> TransactionDaoImpl : utilise

AccountServices ..> AccountFactory : utilise

Application ..> AccountServices
Application ..> TransactionServices
Application ..> CustomerServices

@enduml